# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is private — never commit it, never paste it into a chat, never put a key in your code.

# Your Groq API key. Free to create at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Which model to use.
#
# Providers retire models fairly often, so if you start getting
# "model not found" or a 404, this is the line to change. The current list
# lives at https://console.groq.com/docs/models — copy the model ID exactly
# as it appears there (the ID, not the friendly display name).
#
# Known-good IDs at the time of writing:
#   openai/gpt-oss-120b
#   openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
